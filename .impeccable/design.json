    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Explicit label and high-contrast control stroke.",
      "html": "<label class=\"ds-label\">Produto<input class=\"ds-input\" placeholder=\"Nome ou código\"></label>",
      "css": ".ds-label{display:grid;gap:7px;font:600 .875rem/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;color:var(--ink,#20304b)}.ds-input{min-width:0;min-height:44px;border:1px solid var(--field-rule,#9aa9be);border-radius:var(--control-radius,7px);padding:10px 12px;background:var(--paper,#fff);color:var(--ink,#20304b);font:400 15px/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;caret-color:var(--accent,#204fb0)}.ds-input::placeholder{color:var(--muted,#58677d);opacity:1}.ds-input[readonly]{background:var(--subtle,#f7f9fc)}.ds-input:focus-visible{outline:3px solid var(--accent,#204fb0);outline-offset:3px}"
    },
    {
      "name": "Cobalt navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "White active surface on the dedicated cobalt rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação de exemplo\"><a href=\"#estoque\" aria-current=\"page\">Estoque</a><a href=\"#mapa\">Mapa de posições</a></nav>",
      "css": ".ds-nav{display:grid;gap:3px;padding:18px;background:var(--rail,#204fb0)}.ds-nav a{display:flex;align-items:center;min-height:42px;padding:10px 12px;color:var(--rail-muted,#dce6ff);border-radius:var(--control-radius,7px);font:550 .875rem/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;text-decoration:none;transition:background .16s,color .16s}.ds-nav a:hover{background:rgb(255 255 255 / 12%);color:var(--rail-ink,#fff)}.ds-nav a[aria-current=\"page\"]{background:#fff;color:#173d8c;font-weight:700}.ds-nav a:focus-visible{outline:3px solid #fff;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
