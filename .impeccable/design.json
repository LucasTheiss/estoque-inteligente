      "html": "<button type=\"button\" class=\"ds-button-primary\">Registrar movimentação</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:var(--control-radius,7px);font:650 15px/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;cursor:pointer;transition:background .16s,color .16s;background:var(--accent,#204fb0);color:var(--paper,#fff);}.ds-button-primary:hover{background:var(--accent-hover,#173d8c);color:var(--paper,#fff);}.ds-button-primary:focus-visible{outline:3px solid var(--accent,#204fb0);outline-offset:3px}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}.ds-button-primary[aria-busy=\"true\"]{cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
