      "css": ".ds-button-quiet{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:var(--control-radius,7px);font:650 15px/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;cursor:pointer;transition:background .16s,color .16s;padding:6px 0;background:transparent;color:var(--accent,#204fb0);border:0;font-weight:600;}.ds-button-quiet:hover{background:transparent;color:var(--accent-hover,#173d8c);text-decoration:underline;}.ds-button-quiet:focus-visible{outline:3px solid var(--accent,#204fb0);outline-offset:3px}.ds-button-quiet:disabled{opacity:.5;cursor:not-allowed}.ds-button-quiet[aria-busy=\"true\"]{cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
