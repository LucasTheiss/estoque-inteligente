      "html": "<span class=\"ds-badge\">Dados de demonstração</span>",
      "css": ".ds-badge{display:inline-block;width:fit-content;padding:4px 9px;background:var(--selected,#e8efff);color:var(--selected-ink,#163f91);border-radius:5px;font:600 .75rem/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "card",
      "description": "Solid panel with a precise border and no shadow.",
      "html": "<section class=\"ds-card\"><h2>Dados do produto</h2><p>Consulte o saldo e as posições.</p></section>",
      "css": ".ds-card{padding:24px;background:var(--paper,#fff);color:var(--ink,#20304b);border:1px solid var(--rule,#dce3ee);border-radius:var(--radius,14px);font:15px/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif}.ds-card h2{margin:0 0 18px;font-size:1.2rem;line-height:1.3;letter-spacing:-.02em}.ds-card p{margin:0;max-width:72ch;color:var(--muted,#58677d)}"
    },
    {
      "name": "Position label",
      "kind": "custom",
      "refersTo": "location-code",
      "description": "Recurring physical-position signature.",
      "html": "<a href=\"#posicao\" class=\"ds-location-code\">A-01</a>",
      "css": ".ds-location-code{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:7px 13px;background:var(--selected,#e8efff);color:var(--selected-ink,#163f91);font:750 1.25rem/1.5 \"Segoe UI Variable\",\"Segoe UI\",sans-serif;border-radius:var(--control-radius,7px);text-decoration:none;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ds-location-code:hover{background:var(--accent,#204fb0);color:var(--paper,#fff)}.ds-location-code:focus-visible{outline:3px solid var(--accent,#204fb0);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Wholesale catalog",
    "overview": "Wholesale catalog connects product identity, stock and physical position through a solid cobalt navigation rail and calm working surfaces. Compact tables, explicit labels and humanist typography support repeated counter and warehouse tasks. The selected world replaces the former light-glass treatment completely.\n\nLight is the default. Dark and system preferences preserve the same hierarchy and component geometry. Position labels supply the recurring visual signature; solid surfaces, precise rules and restrained movement keep operational content legible.",
    "keyCharacteristics": [
      "Solid cobalt navigation and cool neutral work areas.",
      "Compact tables with tabular quantities and distinct position labels.",
      "Humanist system typography, explicit labels and visible keyboard focus.",
      "Selectable light, dark and system themes; reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Use foreground and background tokens together when themes change; retain the dedicated rail colors for navigation.",
        "section": "colors"
      },
      {
        "name": "The Quantity Rule",
        "body": "Set quantities and position codes in tabular numerals; align numeric table columns to the right.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Working panels use solid fills and fine borders. Reserve the shipped shadow for transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic foreground/background pairs in both themes.",
      "Do retain explicit labels, visible focus and reduced-motion behavior.",
      "Do repeat position labels consistently across the inspector, map and assisted search.",
      "Do use inline SVG for the existing outline icon language."
    ],
    "donts": [
      "Don't restore translucent glass panels or backdrop blur.",
      "Don't turn compact working tables into decorative cards.",
      "Don't use color alone to communicate selection, errors or device confirmation.",
      "Don't depict demonstration data or simulator acknowledgements as real hardware telemetry."
    ]
  }
}
